{
  "name": "hitokoto（Docker が使える環境）",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false,
      "dockerDashComposeVersion": "none"
    }
  },
  "hostRequirements": {
    "cpus": 2
  },
  "forwardPorts": [
    8000,
    8080
  ],
  "portsAttributes": {
    "8000": {
      "label": "ひとこと掲示板"
    },
    "8080": {
      "label": "Web サーバー（nginx）"
    }
  }
}
